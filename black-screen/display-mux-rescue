#!/bin/bash
# MacBookPro13,3: recover "backlight on, black picture" when the eDP link looks healthy.
# Flips the gmux display switch to the Intel GPU and back to the AMD GPU, then retrains the eDP link.
# Run as root (needs debugfs). Afterwards run display-rescue (or any DPMS off/on) as your user.
# Status: recovered the display once in testing; treat as a best-effort rescue, not a fix.
set -u
[[ $EUID -eq 0 ]] || { echo "run with sudo" >&2; exit 1; }
mountpoint -q /sys/kernel/debug || mount -t debugfs none /sys/kernel/debug
V=/sys/kernel/debug/vgaswitcheroo/switch
[[ -w $V ]] || { echo "vgaswitcheroo not available (is apple-gmux loaded?)" >&2; exit 1; }
# eDP link settings of the AMD GPU (PCI 0000:01:00.0 on this model)
L=$(ls -d /sys/kernel/debug/dri/0000:01:00.0/eDP-1/link_settings /sys/kernel/debug/dri/*/eDP-1/link_settings 2>/dev/null | head -1)
trap 'echo MDIS > "$V"' EXIT          # never leave the panel on the Intel GPU
echo MIGD > "$V"; sleep 4             # switch the panel to the integrated GPU
echo MDIS > "$V"; trap - EXIT; sleep 3  # and back to the discrete GPU
[[ -w $L ]] && echo "4 0xa" > "$L"    # retrain: 4 lanes, HBR2
sleep 3
