# Keep Thunderbolt 3 USB controllers awake on AC so USB-C hotplug works (MacBookPro13,3)
SUBSYSTEM=="power_supply", KERNEL=="ADP1", ACTION=="change", RUN+="/usr/local/bin/tb-usb-power"
SUBSYSTEM=="pci", ACTION=="add", ATTR{vendor}=="0x8086", ATTR{device}=="0x15d4", RUN+="/usr/local/bin/tb-usb-power"
